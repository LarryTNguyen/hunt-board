DATABASE_URL=postgresql+psycopg://hunt_board:hunt_board@localhost:55432/hunt_board
HUNT_BOARD_SOURCES_PATH=data/sources.yaml
# Development/test only. The seed command refuses to create an admin in production.
HUNT_BOARD_DEFAULT_USER_EMAIL=owner@example.test
# One of development, test, staging, production.
HUNT_BOARD_ENVIRONMENT=development
HUNT_BOARD_RELEASE=development
HUNT_BOARD_DEPLOYMENT_ID=local-compose
HUNT_BOARD_PROCESS=web
HUNT_BOARD_PUBLIC_URL=http://127.0.0.1:8000
SUPABASE_URL=https://your-development-project.supabase.co
SUPABASE_ANON_KEY=your_browser_safe_anon_key
SUPABASE_JWT_AUDIENCE=authenticated
# Optional override; defaults to SUPABASE_URL/auth/v1.
SUPABASE_JWT_ISSUER=https://your-development-project.supabase.co/auth/v1
# Never add SUPABASE_SERVICE_ROLE_KEY to the web or frontend environment.
HUNT_BOARD_HTTP_TIMEOUT_SECONDS=30
HUNT_BOARD_SOURCE_CONCURRENCY=5
HUNT_BOARD_HTTP_MAX_RETRIES=2
HUNT_BOARD_HTTP_RETRY_BACKOFF_SECONDS=0.5
HUNT_BOARD_HTTP_RETRY_JITTER_SECONDS=0.25
HUNT_BOARD_RUN_TIMEOUT_SECONDS=3600
# Running rows older than this are recovered as abandoned after the global lock is acquired.
HUNT_BOARD_STALE_RUN_MINUTES=120
# Separate scheduler-process settings. The Compose profile prevents it from starting by default.
HUNT_BOARD_SCHEDULER_ENABLED=true
HUNT_BOARD_SCHEDULER_INTERVAL_SECONDS=7200
HUNT_BOARD_SCHEDULER_RUN_ON_STARTUP=true
HUNT_BOARD_ANOMALY_ZERO_QUARANTINE=true
HUNT_BOARD_ANOMALY_VOLUME_CHANGE_RATIO=0.75
HUNT_BOARD_ANOMALY_MASS_CHANGE_RATIO=0.50
HUNT_BOARD_MAX_JOB_AGE_DAYS=365
